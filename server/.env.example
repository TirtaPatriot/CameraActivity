PORT=8080
# Key entered in the app Settings (X-Api-Key header). Replace with a long random string.
API_KEY=replace-with-a-random-key
# Asustor NAS share mounted (NFS/SMB) on the server host
STORAGE_ROOT=/mnt/nas/activity-camera
DB_URL=jdbc:sqlserver://HOST:1433;databaseName=DB_NAME;encrypt=true;trustServerCertificate=true
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=5
MAX_UPLOAD_MB=1024
