PORT=8080
# NAS share (e.g. Asustor) mounted on the host; in Docker, bind-mount it to /data
STORAGE_ROOT=/data
DB_URL=jdbc:sqlserver://HOST:1433;databaseName=DB_NAME;encrypt=true;trustServerCertificate=true
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=5
MAX_UPLOAD_MB=1024

# First start only: creates the admin account for /admin when none exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: public address encoded in the connect QR (derived from the request when empty)
PUBLIC_URL=
# Zone for dates in the admin panel and date filters
TIMEZONE=Asia/Jakarta
