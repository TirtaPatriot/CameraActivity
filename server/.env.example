PORT=8080
# NAS share (e.g. Asustor) mounted on the host; in Docker, bind-mount it to /data
STORAGE_ROOT=/data
DB_URL=jdbc:sqlserver://HOST:1433;databaseName=DB_NAME;encrypt=true;trustServerCertificate=true
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=5
MAX_UPLOAD_MB=1024

# First start only: creates the admin account for /admin when none exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: public address encoded in the connect QR (derived from the request when empty)
PUBLIC_URL=
# Zone for dates in the admin panel and date filters
TIMEZONE=Asia/Jakarta

# Optional single sign-on (OpenID Connect: Casdoor, Keycloak, Authentik, Google, Microsoft Entra, …).
# Register this redirect URI at the provider: <PUBLIC_URL>/auth/oidc/callback  (set PUBLIC_URL so it is stable)
# Discovery URL (".well-known/openid-configuration"); the issuer URL also works.
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# Claim with the employee ID (NIP); dotted path allowed, e.g. properties.nip. Empty = not synced.
OIDC_USER_CODE_CLAIM=
# Claim with the user's groups; members of OIDC_ADMIN_GROUP become admins (empty = roles set in the panel)
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUP=
# Text of the sign-in button, e.g. "Masuk dengan SSO Tirta Patriot"
OIDC_BUTTON_LABEL=
